#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define HASH_SIZE 10007

typedef struct HashNode {
    char *word;
    int count;
    struct HashNode *next;
} HashNode;

// Simple Jenkins One-at-a-time hash function
unsigned int getHash(const char *str) {
    unsigned int hash = 0;
    while (*str) {
        hash += *str++;
        hash += (hash << 10);
        hash ^= (hash >> 6);
    }
    hash += (hash << 3);
    hash ^= (hash >> 11);
    hash += (hash << 15);
    return hash % HASH_SIZE;
}

// Add or increment word in hash table
void insertHash(HashNode **table, const char *word, int val) {
    unsigned int h = getHash(word);
    HashNode *node = table[h];
    while (node != NULL) {
        if (strcmp(node->word, word) == 0) {
            node->count += val;
            return;
        }
        node = node->next;
    }
    HashNode *newNode = (HashNode *)malloc(sizeof(HashNode));
    newNode->word = strdup(word);
    newNode->count = val;
    newNode->next = table[h];
    table[h] = newNode;
}

// Search frequency of a word in hash table
int searchHash(HashNode **table, const char *word) {
    unsigned int h = getHash(word);
    HashNode *node = table[h];
    while (node != NULL) {
        if (strcmp(node->word, word) == 0) {
            return node->count;
        }
        node = node->next;
    }
    return 0;
}

// Free allocated memory for a hash table
void freeHash(HashNode **table) {
    for (int i = 0; i < HASH_SIZE; i++) {
        HashNode *node = table[i];
        while (node != NULL) {
            HashNode *temp = node;
            node = node->next;
            free(temp->word);
            free(temp);
        }
        table[i] = NULL;
    }
}

int* findSubstring(char* s, char** words, int wordsSize, int* returnSize) {
    *returnSize = 0;
    if (s == NULL || wordsSize == 0 || s[0] == '\0') return NULL;

    int s_len = strlen(s);
    int word_len = strlen(words[0]);
    int total_len = wordsSize * word_len;
    
    if (s_len < total_len) return NULL;

    // Output indices array reservation
    int *result = (int *)malloc(s_len * sizeof(int));
    
    // Hash map to store initial words profile
    HashNode **counts = (HashNode **)calloc(HASH_SIZE, sizeof(HashNode *));
    for (int i = 0; i < wordsSize; i++) {
        insertHash(counts, words[i], 1);
    }

    // Allocate buffer for a single word chunk
    char *temp_word = (char *)malloc((word_len + 1) * sizeof(char));

    // Sliding window loop over word-length offsets
    for (int i = 0; i < word_len; i++) {
        int left = i;
        int count = 0;
        HashNode **curr_window = (HashNode **)calloc(HASH_SIZE, sizeof(HashNode *));

        for (int j = i; j <= s_len - word_len; j += word_len) {
            // Extract the current word chunk
            strncpy(temp_word, s + j, word_len);
            temp_word[word_len] = '\0';

            int target_cnt = searchHash(counts, temp_word);
            if (target_cnt > 0) {
                insertHash(curr_window, temp_word, 1);
                count++;

                // If word count exceeds requirement, slide the left boundary rightward
                while (searchHash(curr_window, temp_word) > target_cnt) {
                    char *left_word = (char *)malloc((word_len + 1) * sizeof(char));
                    strncpy(left_word, s + left, word_len);
                    left_word[word_len] = '\0';
                    
                    insertHash(curr_window, left_word, -1);
                    count--;
                    left += word_len;
                    free(left_word);
                }

                // If the entire words structure is matched
                if (count == wordsSize) {
                    result[(*returnSize)++] = left;
                }
            } else {
                // Reset window if an unrecognized sequence breaks chain
                freeHash(curr_window);
                count = 0;
                left = j + word_len;
            }
        }
        freeHash(curr_window);
        free(curr_window);
    }

    free(temp_word);
    freeHash(counts);
    free(counts);

    return result;
}
