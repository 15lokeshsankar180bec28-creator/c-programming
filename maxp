#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#ifndef MAX
#define MAX(a, b) ((a) > (b) ? (a) : (b))
#endif

#ifndef MIN
#define MIN(a, b) ((a) < (b) ? (a) : (b))
#endif

long long maxProduct(char* s) {
    int n = strlen(s);
    if (n < 2) return 0;

    // Dynamically allocate memory for O(N) array buffers
    int* p = (int*)malloc(n * sizeof(int));
    int* max_left = (int*)malloc(n * sizeof(int));
    int* max_right = (int*)malloc(n * sizeof(int));

    // Initialize tracking arrays
    for (int i = 0; i < n; i++) {
        p[i] = 0;
        max_left[i] = 1;
        max_right[i] = 1;
    }

    // Step 1: Manacher's Algorithm for odd-length palindromes
    int c = 0, r = 0;
    for (int i = 0; i < n; i++) {
        if (i < r) {
            p[i] = MIN(r - i, p[2 * c - i]);
        }
        
        // Expand around center i
        while (i - p[i] - 1 >= 0 && i + p[i] + 1 < n && s[i - p[i] - 1] == s[i + p[i] + 1]) {
            p[i]++;
        }
        
        // Update center and rightmost boundary
        if (i + p[i] > r) {
            c = i;
            r = i + p[i];
        }
    }

    // Step 2: Compute max_left[idx] -> max odd palindrome length ending at or before idx
    int idx = 0;
    for (int i = 0; i < n; i++) {
        while (idx <= i + p[i]) {
            max_left[idx] = MAX(max_left[idx], (idx - i) * 2 + 1);
            idx++;
        }
    }
    // Propagate the maximum value forward
    for (int i = 1; i < n; i++) {
        max_left[i] = MAX(max_left[i], max_left[i - 1]);
    }

    // Step 3: Compute max_right[idx] -> max odd palindrome length starting at or after idx
    idx = n - 1;
    for (int i = n - 1; i >= 0; i--) {
        while (idx >= i - p[i]) {
            max_right[idx] = MAX(max_right[idx], (i - idx) * 2 + 1);
            idx--;
        }
    }
    // Propagate the maximum value backward
    for (int i = n - 2; i >= 0; i--) {
        max_right[i] = MAX(max_right[i], max_right[i + 1]);
    }

    // Step 4: Find the maximum non-intersecting product split point
    long long max_prod = 1;
    for (int i = 0; i < n - 1; i++) {
        long long current_prod = (long long)max_left[i] * max_right[i + 1];
        if (current_prod > max_prod) {
            max_prod = current_prod;
        }
    }

    // Free dynamically allocated memory properly
    free(p);
    free(max_left);
    free(max_right); 

    return max_prod;
}
