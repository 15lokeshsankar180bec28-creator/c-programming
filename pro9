int removeDuplicates(int* nums, int numsSize) {
    // If the array has 2 or fewer elements, no modifications are needed
    if (numsSize <= 2) {
        return numsSize;
    }

    // 'insertIndex' tracks where the next valid element should be written
    int insertIndex = 2;

    for (int i = 2; i < numsSize; i++) {
        // Compare current element with the element two positions behind 'insertIndex'
        if (nums[i] != nums[insertIndex - 2]) {
            nums[insertIndex] = nums[i];
            insertIndex++;
        }
    }

    // 'insertIndex' represents the total valid elements (k)
    return insertIndex;
}

