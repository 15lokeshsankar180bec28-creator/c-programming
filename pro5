#include <stdio.h>

int maxArea(int* height, int heightSize) {
    int left = 0;
    int right = heightSize - 1;
    int max_area = 0;
    
    while (left < right) {
        // Calculate width
        int width = right - left;
        
        // Find minimum height between the two pointers
        int current_height = (height[left] < height[right]) ? height[left] : height[right];
        
        // Calculate current area
        int current_area = width * current_height;
        
        // Update max_area if current is larger
        if (current_area > max_area) {
            max_area = current_area;
        }
        
        // Move the pointer pointing to the shorter vertical line
        if (height[left] < height[right]) {
            left++;
        } else {
            right--;
        }
    }
    
    return max_area;
}
