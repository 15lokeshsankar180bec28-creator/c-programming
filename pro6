#include <stdio.h>
#include <string.h>

// Helper function to expand around center and return palindrome length
int expandAroundCenter(const char *s, int len, int left, int right) {
    while (left >= 0 && right < len && s[left] == s[right]) {
        left--;
        right++;
    }
    return right - left - 1;
}

char* longestPalindrome(char* s) {
    if (s == NULL || strlen(s) == 0) return "";

    int len = strlen(s);
    int start = 0;
    int maxLen = 1;

    for (int i = 0; i < len; i++) {
        // Odd length palindromes (e.g., "aba")
        int len1 = expandAroundCenter(s, len, i, i);
        // Even length palindromes (e.g., "abba")
        int len2 = expandAroundCenter(s, len, i, i + 1);

        int currentMax = (len1 > len2) ? len1 : len2;

        if (currentMax > maxLen) {
            maxLen = currentMax;
            start = i - (currentMax - 1) / 2;
        }
    }

    // Modify string in-place to terminate at the end of the palindrome
    s[start + maxLen] = '\0'; 
    return &s[start];
}
